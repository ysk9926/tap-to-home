# ── PostgreSQL ────────────────────────────────────────────────
# 로컬(docker compose):
DATABASE_URL=postgresql://taptohome:taptohome@localhost:5432/taptohome
DIRECT_URL=postgresql://taptohome:taptohome@localhost:5432/taptohome
#
# Supabase (Dashboard → Connect → ORMs → Drizzle). 프로젝트 ref: afkdblzdwpjzfvttbewt
#   DATABASE_URL = Transaction pooler, 포트 6543  → 앱 런타임(Vercel 서버리스)용
#   DIRECT_URL   = Session pooler,     포트 5432  → prisma migrate 용
#   (Direct connection 은 IPv6 전용이라 로컬 네트워크에서 안 붙을 수 있음 → Session pooler 사용)
#   <password> 는 DB 비밀번호 (Project Settings → Database → Reset database password 로 재설정 가능)
# DATABASE_URL=postgresql://postgres.afkdblzdwpjzfvttbewt:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.afkdblzdwpjzfvttbewt:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
#
# vitest 통합 테스트용 로컬 Postgres (docker compose 기본값과 동일)
# TEST_DATABASE_URL=postgresql://taptohome:taptohome@localhost:5432/taptohome

# ── Supabase Realtime (F1-2 친구 위치 동기화 전용, 인증은 better-auth) ──
# Dashboard → Project Settings → API Keys. 새 키 형식(sb_publishable_ / sb_secret_)만 사용
NEXT_PUBLIC_SUPABASE_URL=https://afkdblzdwpjzfvttbewt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
# 비어 있으면 Realtime 을 끄고 폴링으로 동작한다
SUPABASE_SECRET_KEY=

# ── better-auth ───────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# 로컬: http://localhost:3000 / Vercel production: https://<domain>
BETTER_AUTH_URL=http://localhost:3000

# ── 관리자 전용 인증 (ADR 0010) ─────────────────────────────
# BETTER_AUTH_SECRET과 다른 32자 이상 랜덤 값. openssl rand -base64 32
# 비어 있으면 관리자 인증만 비활성화된다. 브라우저에 노출하지 않는다.
ADMIN_AUTH_SECRET=
# 마스터 계정은 pnpm admin:master create 로 서버에서 생성한다.

# 브라우저·Flutter 웹뷰(--dart-define WEB_URL)가 접근하는 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── /dev/ui 레퍼런스 페이지 (ADR 0004) ───────────────────────
# 개발 환경에서는 없어도 그냥 열린다. 프로덕션에서만 쓰인다.
# 값을 넣으면 https://<domain>/dev/ui?key=<값> 으로 열리고, 비우면 프로덕션에서 닫힌다.
# 닫을 때는 Vercel 에서 값만 지우면 되고 재배포는 필요 없다. openssl rand -hex 16
DEV_UI_KEY=

# ── 네이티브 푸시 (FCM, docs/decisions/0006) ──────────────────
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 → 받은 JSON 을 통째로 한 줄에 넣는다.
# 줄바꿈이 있는 private_key 때문에 셸에서는 작은따옴표로 감싸야 한다.
# 비어 있으면 푸시를 건너뛰고 인앱 토스트만 동작한다 (Realtime 과 같은 방침).
FIREBASE_SERVICE_ACCOUNT_JSON=

# 자정 자동 정산 크론 인증 (ADR 0008). Vercel 이 Bearer 로 실어 보낸다.
# 로컬에서 수동 호출: curl -H "Authorization: Bearer dev-cron-secret" localhost:3000/api/cron/settle
CRON_SECRET=dev-cron-secret
